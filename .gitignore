# Python bytecode caches
__pycache__/
*.pyc

# Local Claude Code settings — carries live credentials, never commit (governance GI-003-repo-secret-hygiene/GI-015-live-token-exposure)
.claude/settings.local.json

# Stale v2-run brainstorm artifacts — topic will be re-run fresh on v2.1 (see BACKLOG, Brainstorm-v2 follow-ups)
.mochiko/brainstorms/setup-workflow-rewrite/
/.claude/worktrees

# Rust build output (the mochiko-cli crate). Cargo.lock IS committed (binary crate).
/target

# Run folders: a run's raw output (console captures, logs, dumps) is ephemeral and never
# committed; the lead removes each folder after the run's acceptance (hook-enforcement-field-review
# D4 control 3; the gate refuses a run-folder write until this line is present)
.mochiko/runs/
