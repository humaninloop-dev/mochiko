{
  "name": "tidewell-api",
  "version": "1.14.0",
  "private": true,
  "engines": { "node": ">=22.6" },
  "scripts": {
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "coverage": "jest --coverage",
    "build": "nest build && npm --prefix web run build",
    "hooks": "husky install",
    "migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "10.4.1",
    "@nestjs/core": "10.4.1",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.1",
    "@prisma/client": "5.19.1",
    "@sentry/node": "8.26.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "csv-parse": "5.5.6",
    "pino": "9.3.2",
    "stripe": "16.8.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "eslint": "9.9.0",
    "husky": "9.1.5",
    "jest": "29.7.0",
    "prisma": "5.19.1",
    "ts-jest": "29.2.5",
    "typescript": "5.5.4"
  }
}
